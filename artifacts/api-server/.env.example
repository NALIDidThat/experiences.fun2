# API server port (required)
PORT=3000

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://localhost:5432/experiences_fun

# Privy auth — get from https://privy.io dashboard
PRIVY_APP_SECRET=sk_your_privy_app_secret

# Telegram — get from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# The public HTTPS URL your Vite dev server is reachable at (ngrok URL for port 5173).
# The bot webhook is registered at ${MINI_APP_URL}/api/telegram/webhook via the Vite proxy.
MINI_APP_URL=https://your-ngrok-url.ngrok-free.app

# OpenAI API key — for AI recommendations and insights
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: ISO timestamp for $EXP token launch countdown
TOKEN_LAUNCH_DATE=2026-01-01T00:00:00Z

# Optional: protects the admin notify endpoint
ADMIN_SECRET=local-dev-secret
